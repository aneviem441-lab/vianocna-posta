# Server configuration
PORT=3456
PROCESSOR_MODE=simulator
DEFAULT_CURRENCY=EUR
HOLD_TTL_DAYS=7

# Optional API Key RBAC (leave blank for open local dev mode)
VIEWER_API_KEY=
OPERATOR_API_KEY=
ADMIN_API_KEY=

# PayPal Orders v2 / Payments v2 (required for paypal_sandbox / paypal_live)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_RETURN_URL=http://localhost:3456/?paypal=approved
PAYPAL_CANCEL_URL=http://localhost:3456/?paypal=cancelled

# Stripe PaymentIntents capture_method=manual (required for stripe)
STRIPE_SECRET_KEY=
